# Create an API key in Soundlink: Settings → Developer → API keys
# Required scopes: campaigns:read, metrics:read
SOUNDLINK_API_KEY=sk_YOUR_PREFIX_YOUR_SECRET

# Public API host (override only for staging/mocks)
SOUNDLINK_BASE_URL=https://api.getsoundlink.com

# Destination: duckdb | bigquery
DESTINATION=duckdb
DUCKDB_PATH=./data/soundlink.duckdb

# Resume + last successful sync metadata
STATE_PATH=./data/sync_state.json

# BigQuery (when DESTINATION=bigquery)
# Install: uv sync --extra bigquery
# BIGQUERY_PROJECT=my-gcp-project
# BIGQUERY_DATASET=soundlink
# BIGQUERY_LOCATION=US

# Incremental re-fetch window: inclusive calendar days ending today
# (default 10 covers the 7-day metrics mutability period)
INCREMENTAL_LOOKBACK_DAYS=10

# Smaller pages reduce 504 risk on GET /v1/campaigns (max 100)
CAMPAIGNS_PAGE_SIZE=25

# HTTP
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=5
